# FlowAI Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── API Server ─────────────────────────────────────────────────────────────
PORT=3000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Credentials used by Docker Compose (docker-compose.yml)
POSTGRES_USER=flowai
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=flowai_dev
POSTGRES_PORT=5432

# Full connection URL consumed by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://flowai:change_me_in_production@localhost:5432/flowai_dev?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Future variables (not used in Phase 0) ──────────────────────────────────
# JWT_SECRET=
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d
# OPENAI_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
